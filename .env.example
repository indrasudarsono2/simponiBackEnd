PORT=3001
NODE_ENV=development
# Generate independent random values of at least 32 characters for both secrets.
JWT_SECRET=
FILE_URL_SECRET=
JWT_ISSUER=simponi-api
JWT_AUDIENCE=simponi-web
# Never works when NODE_ENV=production.
ALLOW_TEST_LOGIN_BYPASS=false
# Comma-separated exact frontend origins, for example http://localhost:3000
CORS_ORIGIN=http://localhost:3000
SIMPONI_PUBLIC_BASE_URL=

# e-chain integration configuration
ECHAIN_MOCK_MODE=false
ECHAIN_BASE_URL=
ECHAIN_PROFILE_SYNC_PATH=/api/integrations/simponi/profile
ECHAIN_LICENSE_SYNC_PATH=/api/integrations/simponi/license
ECHAIN_IELP_USER_SYNC_PATH=/api/integrations/simponi/ielp-user
ECHAIN_MEDEX_USER_SYNC_PATH=/api/integrations/simponi/medex-user
ECHAIN_PRACTICAL_EXAM_SEND_PATH=/api/integrations/simponi/practical-exam
ECHAIN_TIMEOUT_MS=10000
ECHAIN_LICENSE_MAX_FILE_BYTES=2097152
ECHAIN_IELP_USER_MAX_FILE_BYTES=2097152
ECHAIN_MEDEX_USER_MAX_FILE_BYTES=2097152
ECHAIN_BEARER_TOKEN=
ECHAIN_API_KEY=
ECHAIN_WEBHOOK_SECRET=

# SMTP configuration used by workers/escalationWorker.js
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=operations@example.com

PORT=44441
HOST=0.0.0.0
NODE_ENV=development
RUN_ESCALATION_SCHEDULER=true
# Generate independent random values of at least 32 characters for both secrets.
JWT_SECRET=
FILE_URL_SECRET=
JWT_ISSUER=simponi-api
JWT_AUDIENCE=simponi-web
# Never works when NODE_ENV=production.
ALLOW_TEST_LOGIN_BYPASS=false
LOGIN_FAILURE_WINDOW_MINUTES=30
LOGIN_COOLDOWN_THRESHOLD=5
LOGIN_FIRST_COOLDOWN_MINUTES=5
LOGIN_SECOND_COOLDOWN_MINUTES=15
LOGIN_MAXIMUM_COOLDOWN_MINUTES=30
# Comma-separated exact frontend origins, for example http://localhost:44440
CORS_ORIGIN=http://localhost:44440
# Canonical public HTTPS origin used for safe production redirects.
SIMPONI_PUBLIC_BASE_URL=https://api.example.com
# Public browser origin for redirecting back to the PERFORMA login/dashboard.
PERFORMA_PUBLIC_BASE_URL=http://localhost:44440

# AirNav AUTH SSO (Authorization Code + PKCE). Obtain these values from AirNav.
AIRNAV_AUTH_BASE_URL=https://auth.airnavindonesia.co.id/v2
AIRNAV_CLIENT_ID=performa-app
AIRNAV_CLIENT_SECRET=Qultp4iXpkndBYsxEz27fL4nw0XVdkxDXJQb-7tuX4o
AIRNAV_REDIRECT_URI=http://localhost:44441/backend/api/auth/airnav/callback

# e-chain integration configuration
ECHAIN_MOCK_MODE=false
ECHAIN_BASE_URL=
ECHAIN_PROFILE_SYNC_PATH=/api/integrations/simponi/profile
ECHAIN_LICENSE_SYNC_PATH=/api/integrations/simponi/license
ECHAIN_IELP_USER_SYNC_PATH=/api/integrations/simponi/ielp-user
ECHAIN_MEDEX_USER_SYNC_PATH=/api/integrations/simponi/medex-user
ECHAIN_IELP_VERIFIED_SEND_PATH=/api/integrations/simponi/ielp-user/verified
ECHAIN_MEDEX_VERIFIED_SEND_PATH=/api/integrations/simponi/medex-user/verified
ECHAIN_PRACTICAL_EXAM_SEND_PATH=/api/integrations/simponi/practical-exam
ECHAIN_TIMEOUT_MS=10000
ECHAIN_LICENSE_MAX_FILE_BYTES=2097152
ECHAIN_IELP_USER_MAX_FILE_BYTES=2097152
ECHAIN_MEDEX_USER_MAX_FILE_BYTES=2097152
ECHAIN_BEARER_TOKEN=
ECHAIN_API_KEY=
ECHAIN_WEBHOOK_SECRET=

# SMTP configuration used by workers/escalationWorker.js
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=operations@example.com

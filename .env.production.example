NODE_ENV=production
HOST=127.0.0.1
# Trust only verified reverse-proxy peers. Never use an unrestricted hop count.
# Loopback supports local Nginx/Nuxt; add exact gateway CIDRs only if needed.
TRUSTED_PROXY_CIDRS=loopback
# Set false only when an upstream WAF/load balancer owns the public HTTPS boundary.
ENFORCE_HTTPS_REDIRECT=true
PORT=44441
RUN_ESCALATION_SCHEDULER=true
ALLOW_TEST_LOGIN_BYPASS=false

DATABASE_URL=mysql://simponi_app:CHANGE_ME@127.0.0.1:3306/simponi
JWT_SECRET=CHANGE_ME_TO_AN_INDEPENDENT_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
FILE_URL_SECRET=CHANGE_ME_TO_ANOTHER_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_ISSUER=simponi-api
JWT_AUDIENCE=simponi-web

CORS_ORIGIN=https://performa.airnavindonesia.co.id
SIMPONI_PUBLIC_BASE_URL=https://performa.airnavindonesia.co.id/backend
# Public browser origin for redirecting back to the PERFORMA login/dashboard.
PERFORMA_PUBLIC_BASE_URL=https://performa.airnavindonesia.co.id

# AirNav AUTH SSO (Authorization Code + PKCE). Keep the client secret server-side.
AIRNAV_AUTH_BASE_URL=https://auth.airnavindonesia.co.id/v2
AIRNAV_CLIENT_ID=performa-app
AIRNAV_CLIENT_SECRET=
AIRNAV_REDIRECT_URI=https://performa.airnavindonesia.co.id/backend/api/auth/airnav/callback

LOGIN_FAILURE_WINDOW_MINUTES=30
LOGIN_COOLDOWN_THRESHOLD=5
LOGIN_FIRST_COOLDOWN_MINUTES=5
LOGIN_SECOND_COOLDOWN_MINUTES=15
LOGIN_MAXIMUM_COOLDOWN_MINUTES=30

ECHAIN_MOCK_MODE=false
ECHAIN_BASE_URL=
ECHAIN_BEARER_TOKEN=
ECHAIN_API_KEY=
ECHAIN_WEBHOOK_SECRET=

MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=operations@example.com

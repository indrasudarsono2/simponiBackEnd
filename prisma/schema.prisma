  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user              User?       @relation(fields: [userNik], references: [nik])
  cwp               Cwp?        @relation(fields: [cwpId], references: [id])
  dutyReport        DutyReport? @relation(fields: [dutyReportId], references: [id])
  supervisorLogBook User?       @relation("SupervisorLogBook", fields: [supervisor], references: [nik])
  shift             Shift?      @relation(fields: [shiftId], references: [id])
}

model Supervisor {
  id           Int     @id @default(autoincrement())
  branchUnitId Int?    @db.Int()
  supervisor   String? @db.VarChar(150)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  cwpSupervisors CwpSupervisor[]
  dutyReports    DutyReport[]
  branchUnit     BranchUnit?     @relation(fields: [branchUnitId], references: [id])
}

model CwpSupervisor {
  id           Int  @id @default(autoincrement())
  cwpId        Int? @db.Int()
  supervisorId Int? @db.Int()

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  cwp        Cwp?        @relation(fields: [cwpId], references: [id])
  supervisor Supervisor? @relation(fields: [supervisorId], references: [id])
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Region {
  id        Int       @id @default(autoincrement())
  region    String?   @db.VarChar(150)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  branches Branch[]
}

model Branch {
  id        Int       @id @default(autoincrement())
  regionId  Int?      @db.Int
  branch    String?   @db.VarChar(150)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  region               Region?              @relation(fields: [regionId], references: [id])
  branchUnits          BranchUnit[]
  professionInBranches ProfessionInBranch[]
  users                User[]
  onGoingIssues        OnGoingIssue[]
  briefings            Briefing[]
  escalationActors     EscalationActor[]
  escalations          Escalation[]
  escalationLevels     EscalationLevel[]
}

model BranchUnit {
  id        Int       @id @default(autoincrement())
  branchId  Int?      @db.Int
  unit      String?   @db.VarChar(150)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  branch          Branch?          @relation(fields: [branchId], references: [id])
  sectors         Sector[]
  sessions        Session[]
  multipleChoices MultipleChoice[]
  essays          Essay[]
  users           User[]
  shiftNames      ShiftName[]
  tokens          token?
  supervisors     Supervisor[]
}

model QuestionGroup {
  id                    Int       @id @default(autoincrement())
  kindOfQuestionId      Int?      @db.Int
  subBranchUnitRatingId Int?      @db.Int
  mandatoryRatingId     Int?      @db.Int
  group                 String?   @db.Text
  quantity              Int?      @db.Int
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  subBranchUnitRating SubBranchUnitRating? @relation(fields: [subBranchUnitRatingId], references: [id])
  kindOfQuestion      KindOfQuestion?      @relation(fields: [kindOfQuestionId], references: [id])
  mandatoryRating     MandatoryRating?     @relation(fields: [mandatoryRatingId], references: [id])
  essayQuestionGroups EssayQuestionGroup[]
  mcQuestionGroups    McQuestionGroup[]
}

model MandatoryRating {
  id              Int       @id @default(autoincrement())
  ratingId        Int?      @db.Int
  mandatoryItemId Int?      @db.Int
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  mandatoryItem  MandatoryItems? @relation(fields: [mandatoryItemId], references: [id])
  rating         Rating?         @relation(fields: [ratingId], references: [id])
  questionGroups QuestionGroup[]
}

model MandatoryItems {
  id        Int       @id @default(autoincrement())
  mandatory String?   @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  mandatoryRatings MandatoryRating[]
  matsQuestions    MultipleChoice[]
  matsAllocations  MatsCategoryAllocation[]
  matsSelections   MatsQuestionSelection[]
  mcCorrections    MultipleChoiceCorrection[]
}

model MultipleChoice {
  id                     Int       @id @default(autoincrement())
  branchUnitId           Int?      @db.Int
  mandatoryItemId        Int?      @db.Int
  parentMultipleChoiceId Int?      @db.Int
  versionGroupId         Int?      @db.Int
  version                Int       @default(1) @db.Int
  isActive               Boolean   @default(true)
  isMats                 Boolean   @default(false)
  question               String?   @db.Text
  image                  String?   @db.Text
  a                      String?   @db.Text
  b                      String?   @db.Text
  c                      String?   @db.Text
  d                      String?   @db.Text
  key                    String?   @db.VarChar(10)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?

  branchUnit               BranchUnit?                @relation(fields: [branchUnitId], references: [id])
  mandatoryItem            MandatoryItems?            @relation(fields: [mandatoryItemId], references: [id])
  parentMultipleChoice     MultipleChoice?            @relation("MultipleChoiceVersions", fields: [parentMultipleChoiceId], references: [id])
  childMultipleChoices     MultipleChoice[]           @relation("MultipleChoiceVersions")
  multipleChoiceCorections MultipleChoiceCorrection[]
  mcQuestionGroups         McQuestionGroup[]
  matsSelections           MatsQuestionSelection[]

  @@index([isMats, isActive, deletedAt])
  @@index([mandatoryItemId, isMats, isActive, deletedAt])
}

model MatsConfiguration {
  id        Int      @id @default(1)
  quantity  Int      @default(0) @db.Int
  mode      String   @default("SEPARATE_POOL") @db.VarChar(30)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MatsCategoryAllocation {
  id              Int       @id @default(autoincrement())
  mandatoryItemId Int       @unique @db.Int
  quantity        Int       @default(0) @db.Int
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  mandatoryItem MandatoryItems @relation(fields: [mandatoryItemId], references: [id])
}

model MatsQuestionSelection {
  id               Int      @id @default(autoincrement())
  appRatingId      Int      @db.Int
  eventId          Int      @db.Int
  multipleChoiceId Int      @db.Int
  slot             Int      @db.Int
  mode             String   @default("SEPARATE_POOL") @db.VarChar(30)
  mandatoryItemId  Int?     @db.Int
  createdAt        DateTime @default(now())

  appRating      AppRating       @relation(fields: [appRatingId], references: [id], onDelete: Cascade)
  event          Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  multipleChoice MultipleChoice  @relation(fields: [multipleChoiceId], references: [id])
  mandatoryItem  MandatoryItems? @relation(fields: [mandatoryItemId], references: [id])

  @@unique([appRatingId, eventId, multipleChoiceId])
  @@unique([appRatingId, eventId, slot])
  @@index([appRatingId, eventId])
}

model McQuestionGroup {
  id               Int       @id @default(autoincrement())
  sectorId         Int?      @db.Int
  multipleChoiceId Int?      @db.Int
  questionGroupId  Int?      @db.Int
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  sector         Sector?         @relation(fields: [sectorId], references: [id])
  multipleChoice MultipleChoice? @relation(fields: [multipleChoiceId], references: [id])
  questionGroup  QuestionGroup?  @relation(fields: [questionGroupId], references: [id])
}

model MultipleChoiceCorrection {
  id               Int       @id @default(autoincrement())
  appRatingId      Int?      @db.Int
  multipleChoiceId Int?      @db.Int
  finalScoreId     Int?      @db.Int
  groupMemberId    Int?      @db.Int
  answer           String?   @db.VarChar(5)
  isTrue           Boolean   @default(false)
  matsMode         String?   @db.VarChar(30)
  mandatoryItemId  Int?      @db.Int
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  appRating      AppRating?      @relation(fields: [appRatingId], references: [id])
  multipleChoice MultipleChoice? @relation(fields: [multipleChoiceId], references: [id])
  finalScore     FinalScore?     @relation(fields: [finalScoreId], references: [id])
  groupMember    GroupMember?    @relation(fields: [groupMemberId], references: [id])
  mandatoryItem  MandatoryItems? @relation(fields: [mandatoryItemId], references: [id])
}

model Essay {
  id             Int       @id @default(autoincrement())
  branchUnitId   Int?      @db.Int
  parentEssayId  Int?      @db.Int
  versionGroupId Int?      @db.Int
  version        Int       @default(1) @db.Int
  isActive       Boolean   @default(true)
  question       String?   @db.Text
  image          String?   @db.Text
  answer         String?   @db.Text
  value          Int?      @db.Int
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  branchUnit          BranchUnit?          @relation(fields: [branchUnitId], references: [id])
  parentEssay         Essay?               @relation("EssayVersions", fields: [parentEssayId], references: [id])
  childEssays         Essay[]              @relation("EssayVersions")
  essayCorrections    EssayCorrection[]
  essayQuestionGroups EssayQuestionGroup[]
}

model EssayQuestionGroup {
  id              Int       @id @default(autoincrement())
  sectorId        Int?      @db.Int
  essayId         Int?      @db.Int
  questionGroupId Int?      @db.Int
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  sector        Sector?        @relation(fields: [sectorId], references: [id])
  essay         Essay?         @relation(fields: [essayId], references: [id])
  questionGroup QuestionGroup? @relation(fields: [questionGroupId], references: [id])
}

model EssayCorrection {
  id            Int       @id @default(autoincrement())
  appRatingId   Int?      @db.Int
  essayId       Int?      @db.Int
  groupMemberId Int?      @db.Int
  finalScoreId  Int?      @db.Int
  checker       String?   @db.VarChar(150)
  answer        String?   @db.Text()
  score         Float?    @db.Float
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  appRating   AppRating?   @relation(fields: [appRatingId], references: [id])
  essay       Essay?       @relation(fields: [essayId], references: [id])
  groupMember GroupMember? @relation(fields: [groupMemberId], references: [id])
  checkerUser User?        @relation("checkerEssay", fields: [checker], references: [nik])
  finalScore  FinalScore?  @relation(fields: [finalScoreId], references: [id])
}

model Rating {
  id           Int       @id @default(autoincrement())
  professionId Int?      @db.Int
  rating       String?   @db.VarChar(150)
  description  String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  subBranchUnitRatings SubBranchUnitRating[]
  profession           Profession?           @relation(fields: [professionId], references: [id])
  appRatings           AppRating[]
  userRatings          userRating[]
  competences          Competence[]
  checkerRatings       CheckerRating[]
  mandatoryRatings     MandatoryRating[]
  cwp                  Cwp[]
}

model PracticalTest {
  id                Int       @id @default(autoincrement())
  groupMemberId     Int?      @db.Int
  checkerGroupId    Int?      @db.Int
  appRatingId       Int?      @db.Int
  kindOfPracticalId Int?      @db.Int
  score             Float?    @db.Float
  file              String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  groupMember     GroupMember?              @relation(fields: [groupMemberId], references: [id])
  checkerGroup    CheckerGroup?             @relation(fields: [checkerGroupId], references: [id])
  appRating       AppRating?                @relation(fields: [appRatingId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  kindOfPractical KindOfPractical?          @relation(fields: [kindOfPracticalId], references: [id])
  recheckAttempts PracticalRecheckAttempt[]
  echainSyncs     PracticalExamEchainSync[]
}

model PracticalExamEchainSync {
  id                        Int       @id @default(autoincrement())
  practicalTestId           Int       @db.Int
  practicalRecheckAttemptId Int?      @db.Int
  echainRequestId           String?   @db.VarChar(150)
  status                    String    @default("PENDING") @db.VarChar(50)
  requestPayload            Json?
  responsePayload           Json?
  errorMessage              String?   @db.Text
  sentAt                    DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  practicalTest           PracticalTest            @relation(fields: [practicalTestId], references: [id], onDelete: Cascade)
  practicalRecheckAttempt PracticalRecheckAttempt? @relation(fields: [practicalRecheckAttemptId], references: [id], onDelete: Cascade)

  @@index([practicalTestId])
  @@index([practicalRecheckAttemptId])
  @@index([status])
}

model KindOfPractical {
  id        Int       @id @default(autoincrement())
  kind      String    @db.VarChar(100)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  practicalTests PracticalTest[]
}

model SubBranchUnitRating {
  id        Int       @id @default(autoincrement())
  sectorId  Int?      @db.Int
  ratingId  Int?      @db.Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  sector         Sector?         @relation(fields: [sectorId], references: [id])
  rating         Rating?         @relation(fields: [ratingId], references: [id])
  questionGroups QuestionGroup[]
}

model Sector {
  id           Int       @id @default(autoincrement())
  branchUnitId Int?      @db.Int
  sector       String?   @db.VarChar(150)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  branchUnit           BranchUnit?           @relation(fields: [branchUnitId], references: [id])
  users                User[]
  subBranchUnitRatings SubBranchUnitRating[]
  events               Event[]
  eventQuestions       EventQuestion[]
  essayQuestionGroups  EssayQuestionGroup[]
  mcQuestionGroups     McQuestionGroup[]
  sectorCwps           SectorCwp[]
}

model Session {
  id           Int       @id @default(autoincrement())
  branchUnitId Int?      @db.Int
  session      String?   @db.VarChar(150)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  branchUnit BranchUnit? @relation(fields: [branchUnitId], references: [id])
  events     Event[]
}

model Event {
  id              Int       @id @default(autoincrement())
  sessionId       Int?      @db.Int
  sectorId        Int?      @db.Int
  remarkDocId     Int?      @db.Int
  event           String?   @db.VarChar(150)
  formFillingDate DateTime?
  startDate       DateTime?
  finishDate      DateTime?
  forExpiredDate  DateTime?
  briefingFile    String?   @db.Text
  passingGrade    Float?    @db.Float()
  isPractical     Boolean   @default(false)
  isSimulator     Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  session        Session?                @relation(fields: [sessionId], references: [id])
  sector         Sector?                 @relation(fields: [sectorId], references: [id])
  remarkDoc      RemarkDoc?              @relation(fields: [remarkDocId], references: [id])
  eventUsers     EventUser[]
  groups         Group[]
  eventQuestions EventQuestion[]
  finalScores    FinalScore[]
  previews       Preview[]
  matsSelections MatsQuestionSelection[]
}

model EventQuestion {
  id               Int       @id @default(autoincrement())
  sectorId         Int?      @db.Int
  eventId          Int?      @db.Int
  kindOfQuestionId Int?      @db.Int
  quantity         Int?      @db.Int
  persentage       Float?    @db.Float
  minutes          Int?      @db.Int
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  sector         Sector?         @relation(fields: [sectorId], references: [id])
  event          Event?          @relation(fields: [eventId], references: [id])
  kindOfQuestion KindOfQuestion? @relation(fields: [kindOfQuestionId], references: [id])
  monitorTimes   MonitorTime[]
}

model KindOfQuestion {
  id        Int       @id @default(autoincrement())
  question  String?   @db.VarChar(100)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  eventQuestions EventQuestion[]
  questionGroups QuestionGroup[]
}

model EventUser {
  id        Int       @id @default(autoincrement())
  eventId   Int?      @db.Int
  userNik   String?   @db.VarChar(150)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  event           Event?           @relation(fields: [eventId], references: [id])
  user            User?            @relation(fields: [userNik], references: [nik])
  applicationDocs ApplicationDoc[]
  attendaces      Attendance?
}

model Group {
  id        Int       @id @default(autoincrement())
  eventId   Int?      @db.Int
  pic       String?   @db.VarChar(150)
  group     String?   @db.VarChar(150)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  event         Event?         @relation(fields: [eventId], references: [id])
  userPic       User?          @relation("PicGroup", fields: [pic], references: [nik])
  checkerGroups CheckerGroup[]
  groupMembers  GroupMember[]
}

model GroupMember {
  id        Int       @id @default(autoincrement())
  groupId   Int?      @db.Int
  member    String?   @db.VarChar(150)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  group                     Group?                     @relation(fields: [groupId], references: [id])
  userMember                User?                      @relation("GroupMember", fields: [member], references: [nik])
  essayCorrections          EssayCorrection[]
  practicalTests            PracticalTest[]
  verification              Verification[]
  finalScores               FinalScore[]
  multipleChoiceCorrections MultipleChoiceCorrection[]
  previews                  Preview[]
}

model CheckerGroup {
  id        Int       @id @default(autoincrement())
  groupId   Int?      @db.Int
  checker   String?   @db.VarChar(150)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  group                    Group?                    @relation(fields: [groupId], references: [id])
  userChecker              User?                     @relation("CheckerGroup", fields: [checker], references: [nik])
  practicalTests           PracticalTest[]
  practicalRecheckAttempts PracticalRecheckAttempt[]
}

model Medex {
  id          Int       @id @default(autoincrement())
  isConfirmed Boolean   @default(false)
  institution String?   @db.VarChar(150)
  userNik     String?   @db.VarChar(150)
  released    DateTime?
  expired     DateTime?
  examiner    String?   @db.VarChar(150)
  file        String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  user            User?            @relation(fields: [userNik], references: [nik])
  applicationDocs ApplicationDoc[]
}

model Ielp {
  id          Int       @id @default(autoincrement())
  isConfirmed Boolean   @default(false)
  userNik     String?   @db.VarChar(150)
  released    DateTime?
  expired     DateTime?
  rater       String?   @db.VarChar(150)
  institution String?   @db.VarChar(150)
  level       String?   @db.VarChar(150)
  file        String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  user            User?            @relation(fields: [userNik], references: [nik])
  applicationDocs ApplicationDoc[]
}

model License {
  id          Int       @id @default(autoincrement())
  userNik     String?   @db.VarChar(150)
  note        String?   @db.VarChar(150)
  file        String?   @db.Text
  expiredDate DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  user            User?            @relation(fields: [userNik], references: [nik])
  applicationDocs ApplicationDoc[]
}

model LogBookUser {
  id        Int       @id @default(autoincrement())
  userNik   String?   @db.VarChar(150)
  note      String?   @db.VarChar(150)
  file      String?   @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user            User?            @relation(fields: [userNik], references: [nik])
  applicationDocs ApplicationDoc[]
}

model ApplicationDoc {
  id             Int       @id @default(autoincrement())
  doc            String?   @db.Text
  number         String?   @db.VarChar(150)
  eventUserId    Int?      @db.Int
  userNik        String?   @db.VarChar(150)
  statusId       Int?      @db.Int
  medexId        Int?      @db.Int
  ielpId         Int?      @db.Int
  briefingDate   DateTime?
  confirmRating  Boolean   @default(false)
  reason         String?   @db.Text
  location       String?   @db.VarChar(150)
  rating         String?   @db.Text
  dateForExpired DateTime?
  confirmOjt     Boolean   @default(false)
  ojtLicenseId   String?   @map("ojtNik") @db.VarChar(150)
  letterNumber   String?   @db.VarChar(150)
  letterDate     DateTime?
  controlHour    String?   @db.VarChar(150)
  atsName        String?   @db.VarChar(150)
  address        String?   @db.Text
  isDrugs        Boolean   @default(false)
  isFailed       Boolean   @default(false)
  licenseId      Int?      @db.Int
  logbookUserId  Int?      @db.Int
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  user          User?         @relation("UserApplications", fields: [userNik], references: [nik])
  eventUser     EventUser?    @relation(fields: [eventUserId], references: [id])
  status        status?       @relation(fields: [statusId], references: [id])
  ojtUser       User?         @relation("OjtApplication", fields: [ojtLicenseId], references: [licenseUserId])
  medex         Medex?        @relation(fields: [medexId], references: [id])
  ielp          Ielp?         @relation(fields: [ielpId], references: [id])
  license       License?      @relation(fields: [licenseId], references: [id])
  logbook       LogBookUser?  @relation(fields: [logbookUserId], references: [id])
  appRatings    AppRating[]
  verifications Verification?
}

model Verification {
  id               Int       @id @default(autoincrement())
  applicationDocId Int?      @unique @db.Int
  groupMemberId    Int?      @db.Int
  verificationData String?   @db.Text
  isValid          Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  applicationDoc ApplicationDoc? @relation(fields: [applicationDocId], references: [id])
  groupMembers   GroupMember?    @relation(fields: [groupMemberId], references: [id])
}

model AppRating {
  id               Int       @id @default(autoincrement())
  applicationDocId Int?      @db.Int
  ratingId         Int?      @db.Int
  controlHour      String?   @db.VarChar(150)
  statusId         Int?      @db.Int
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  applicationDoc                ApplicationDoc?                @relation(fields: [applicationDocId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  rating                        Rating?                        @relation(fields: [ratingId], references: [id])
  status                        status?                        @relation(fields: [statusId], references: [id])
  multipleChoiceCorections      MultipleChoiceCorrection[]
  essayCorrections              EssayCorrection[]
  practicalTests                PracticalTest[]
  finalScores                   FinalScore[]
  monitorTimes                  MonitorTime[]
  previews                      Preview[]
  matsSelections                MatsQuestionSelection[]
  examinationInvalidations      ExaminationInvalidation[]
  practicalRecheckAuthorization PracticalRecheckAuthorization?
}

model PracticalRecheckAuthorization {
  id           Int       @id @default(autoincrement())
  appRatingId  Int       @unique @db.Int
  grantedBy    String    @db.VarChar(150)
  reason       String    @db.Text
  passingGrade Float     @db.Float
  status       String    @default("ACTIVE") @db.VarChar(30)
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  appRating AppRating                 @relation(fields: [appRatingId], references: [id], onDelete: Restrict)
  attempts  PracticalRecheckAttempt[]
}

model PracticalRecheckAttempt {
  id              Int      @id @default(autoincrement())
  authorizationId Int      @db.Int
  practicalTestId Int      @db.Int
  checkerGroupId  Int?     @db.Int
  score           Float?   @db.Float
  file            String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  authorization PracticalRecheckAuthorization @relation(fields: [authorizationId], references: [id], onDelete: Restrict)
  practicalTest PracticalTest                 @relation(fields: [practicalTestId], references: [id], onDelete: Restrict)
  checkerGroup  CheckerGroup?                 @relation(fields: [checkerGroupId], references: [id])
  echainSyncs   PracticalExamEchainSync[]

  @@unique([authorizationId, practicalTestId])
  @@index([checkerGroupId, authorizationId])
}

model User {
  nik                  String    @id
  licenseUserId        String?   @unique @db.VarChar(20)
  professionInBranchId Int?      @db.Int
  sectorId             Int?      @db.Int
  branchId             Int?      @db.Int
  branchUnitId         Int?      @db.Int
  name                 String?   @db.VarChar(150)
  password             String?   @db.VarChar(200)
  dateOfBirth          DateTime?
  placeOfBirth         String?
  personalAddress      String?   @db.Text
  nationality          String?   @db.VarChar(100)
  phoneNumber          String?   @db.VarChar(100)
  genderId             Int?      @db.Int
  email                String?   @db.VarChar(200)
  tokenVersion         Int       @default(0) @db.Int
  createdAt            DateTime  @default(now())
